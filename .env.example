# --- Base de datos MySQL / MariaDB -----------------------------------
# XAMPP:        DB_HOST=localhost  DB_NOMBRE=el_faro  DB_USUARIO=el_faro_app
# InfinityFree: datos del panel "Bases de datos MySQL"
#               (MySQL Host Name, MySQL DB Name, MySQL User Name, contraseña de vPanel)
DB_HOST=localhost
DB_PUERTO=3306
DB_NOMBRE=el_faro
DB_USUARIO=el_faro_app
DB_CLAVE=
